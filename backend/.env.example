# Server
NODE_ENV=production
PORT=5005
FRONTEND_URL=https://your-frontend-domain.com

# Hostinger MySQL database credentials (create database/user in hPanel)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=your_database_name
MYSQL_USER=your_database_user
MYSQL_PASSWORD=your_database_password
MYSQL_CONNECTION_LIMIT=5

# Security: replace with long random secrets (32+ characters)
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_another_long_random_secret

# Organization details (optional)
ORGANIZATION_NAME=Seemanchal Express
ORGANIZATION_EMAIL=mail@seemanchalexpress.in
ORGANIZATION_PHONE=9871023184
ORGANIZATION_ADDRESS=F 65, Shaheen Bagh, Okhla, New Delhi-110025
